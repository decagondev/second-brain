{
  "title": "Second Brain: tenant",
  "uid": "sb-tenant",
  "templating": { "list": [{ "name": "tenant", "type": "query", "query": "label_values(sb_asks_total, tenant)" }] },
  "panels": [
    { "title": "Ask latency p50 / p95", "type": "timeseries", "targets": [
      { "expr": "histogram_quantile(0.5, sum by (le) (rate(sb_ask_seconds_bucket{tenant=\"$tenant\"}[5m])))" },
      { "expr": "histogram_quantile(0.95, sum by (le) (rate(sb_ask_seconds_bucket{tenant=\"$tenant\"}[5m])))" } ] },
    { "title": "Answers by outcome", "type": "timeseries", "targets": [
      { "expr": "sum by (outcome) (rate(sb_asks_total{tenant=\"$tenant\"}[5m]))" } ] },
    { "title": "ACL unknown rate by connector", "type": "timeseries", "targets": [
      { "expr": "sum by (connector) (rate(sb_acl_verdicts_total{tenant=\"$tenant\",verdict=\"unknown\"}[30m])) / sum by (connector) (rate(sb_acl_verdicts_total{tenant=\"$tenant\"}[30m]))" } ] },
    { "title": "Freshness by connector", "type": "timeseries", "targets": [
      { "expr": "sb_ingest_last_success_age_seconds{tenant=\"$tenant\"}" } ] },
    { "title": "Model tokens", "type": "timeseries", "targets": [
      { "expr": "sum by (direction) (rate(sb_model_tokens_total{tenant=\"$tenant\"}[1h]))" } ] },
    { "title": "Budget and rate refusals", "type": "timeseries", "targets": [
      { "expr": "sum by (reason) (rate(sb_budget_refusals_total{tenant=\"$tenant\"}[1h]))" } ] },
    { "title": "Law violations (any is Sev-1)", "type": "stat", "targets": [
      { "expr": "sum by (law) (law_violation_total{tenant=\"$tenant\"})" } ] }
  ]
}
