# Pinned tool versions. CI and the Makefile read this file; nothing else may pin versions.
GO_VERSION=1.24
PYTHON_VERSION=3.12
GOLANGCI_LINT_VERSION=2.5.0
# v1.7.4 is TLA+'s latest stable release. v1.8.0 is a prerelease that upstream rebuilds in
# place, so its checksum can't be pinned (it changed on 2026-11-19 and failed CI).
TLA2TOOLS_VERSION=1.7.4
TLA2TOOLS_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
ALLOY_VERSION=6.2.0
ALLOY_SHA256=6b8c1cb5bc93bedfc7c61435c4e1ab6e688a242dc702a394628d9a9801edb78d
MERMAID_VERSION=11
# Never let `go` download a newer toolchain than GO_VERSION (ADR-0017).
GOTOOLCHAIN=local
