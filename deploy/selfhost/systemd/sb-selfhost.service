# The self-hosted cell as a system service (sb-selfhost(7), Running it on a box; SB-1604).
# Install: copy the repository (or the release's deploy/ and tools/selfhost) to
# /opt/second-brain, run `make selfhost` once, then
#   systemctl enable --now sb-selfhost.service sb-selfhost-update.timer
[Unit]
Description=Second Brain self-hosted cell
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/second-brain
ExecStart=/bin/bash tools/selfhost/compose.sh up -d
ExecStop=/bin/bash tools/selfhost/compose.sh stop

[Install]
WantedBy=multi-user.target
