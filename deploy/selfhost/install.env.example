# A self-hosted cell's install settings (sb-selfhost(7), Install; SB-1605). Copy this file,
# fill it in, and run:  sudo tools/selfhost/install.sh /etc/second-brain/install.env
# Paths are on this machine. Nothing here is a secret: secrets are files it names, or are
# made on this machine by the install and never leave it.

# The tenant, exactly as the manifest names it, and the manifest itself (sb-tenant(5)).
SB_TENANT=acme-logistics
SB_MANIFEST=/etc/second-brain/tenant.yaml
# The tenant's own policy (Cedar), optional.
#SB_POLICY=/etc/second-brain/acme-logistics.cedar

# Where people reach the cell. On a real install: the machine's DNS name, port 443, and
# every address (0.0.0.0), with port 80 for ACME's challenge.
SB_HOST=brain.acme.example
SB_PORT=443
SB_HTTP_PORT=80
SB_BIND=0.0.0.0

# TLS: acme (a public name; Caddy gets and renews a certificate), files (the company's
# certificate and key, and the CA that signed it if it isn't a public one), or internal
# (Caddy's own CA, for a lab; every browser must trust it).
SB_TLS=files
SB_TLS_CERT=/etc/second-brain/tls/brain.crt
SB_TLS_KEY=/etc/second-brain/tls/brain.key
#SB_TLS_CA=/etc/second-brain/tls/company-ca.crt
#SB_ACME_EMAIL=it@acme.example

# Sign-in: company (the company's OIDC IdP, which must put the cell's tenant in a `tenant`
# claim and the directory's user id in `sub`, sb-identity(7)), or bundled (sb-idp(1), for
# a site with no IdP the cell can reach). dev is refused anywhere but loopback.
SB_IDP=company
SB_OIDC_ISSUER=https://login.acme.example
SB_OIDC_CLIENT_ID=second-brain
SB_OIDC_SECRET_FILE=/etc/second-brain/oidc-client-secret

# The folder share to read (docs: folder in the manifest), mounted read-only; optional.
SB_SHARE=/srv/shares/company

# The backup's off-box copy: a directory on another machine, mounted here (NFS or SMB),
# writable by uid 65532. Required: three copies, one of them off this machine.
SB_OFFSITE=/mnt/backup-nas/second-brain
# Or the company's S3 bucket (SB-2303), with its key pair in a root-only file:
#   {"access_key": "…", "secret_key": "…"}, and "endpoint" and "region" for a store other
#   than AWS. Copies there are always sealed; the bucket's lifecycle rule keeps 15 days of db/.
#SB_OFFSITE=s3://acme-backups/second-brain
#SB_OFFSITE_KEY_FILE=/etc/second-brain/offsite-key.json

# Where releases come from and the one identity that signs them (sb-release(7)): the
# factory's https:// store with its pull token, or, for an air-gapped site, a directory
# releases are copied into.
SB_RELEASE_STORE=https://releases.example/acme-logistics
SB_RELEASE_PULL_TOKEN_FILE=/etc/second-brain/release-pull-token
SB_RELEASE_TRUSTED=ed25519:REPLACE_WITH_THE_RELEASE_KEY
# Where the bundle's images live; local for images loaded from an install bundle.
SB_RELEASE_REGISTRY=local

# The company's outbound proxy (SB-1806), for api, ingest, jobs and the updater only. A URL
# with no credentials here; one with credentials goes in a file (root-only), never here.
# The cell's own names never use it; add the company's own hosts (an internal IdP, a
# share's server) to SB_NO_PROXY.
#SB_HTTPS_PROXY=http://proxy.acme.example:3128
#SB_HTTPS_PROXY_FILE=/etc/second-brain/https-proxy
#SB_NO_PROXY=login.acme.example,.corp.acme.example

# Notifications by email (SB-2601), for a box without a chat bot: the company's mail server
# (STARTTLS required) and the sender. A server that wants a sign-in reads it from a
# root-only file (mode 0600) holding {"username": "…", "password": "…"}, never from here.
#SB_EMAIL_SERVER=mail.acme.example:587
#SB_EMAIL_FROM=brain@acme.example
#SB_EMAIL_LOGIN_FILE=/etc/second-brain/email-login

# The database (SB-1807): bundled (a postgres container on this machine) or external (the
# company's Postgres 17 with pgvector, on another machine). The file holds the connection
# string, which must say sslmode=verify-full; a private CA for the server goes in
# SB_DATABASE_CA.
#SB_DATABASE=external
#SB_DATABASE_DSN_FILE=/etc/second-brain/database-dsn
#SB_DATABASE_CA=/etc/second-brain/tls/db-ca.crt

# Off-box copies sealed to the recovery key (SB-1901): on unless this says off. After the
# install, make the recovery kit: install.sh --recovery-kit (sb-selfhost(7)).
#SB_SEAL=off
