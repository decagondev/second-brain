{
  "$id": "https://example.com/second-brain/tenant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "contains": {
        "const": "ask"
      },
      "description": "Enabled agents; ask is required.",
      "items": {
        "enum": [
          "ask",
          "draft-reply",
          "incident-summary",
          "spec-digest",
          "close-checklist",
          "runbook-answer",
          "policy-answer",
          "clause-finder",
          "account-brief",
          "case-brief",
          "brand-check",
          "sop-steps",
          "design-rationale",
          "exec-brief"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "approval": {
      "additionalProperties": {
        "pattern": "^group:[A-Za-z0-9._-]+$",
        "type": "string"
      },
      "description": "Workflow to approving IdP group.",
      "propertyNames": {
        "enum": [
          "ticket-update"
        ]
      },
      "type": "object"
    },
    "asks_per_minute": {
      "default": 6,
      "description": "Questions one person may ask in any minute; one more is ERATE (SB-2305).",
      "maximum": 600,
      "minimum": 1,
      "type": "integer"
    },
    "barriers": {
      "description": "Information barriers: pairs of groups that never meet (sb-space(5)).",
      "items": {
        "items": {
          "pattern": "^group:[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array",
        "uniqueItems": true
      },
      "maxItems": 20,
      "type": "array"
    },
    "budget_usd_month": {
      "default": 1000,
      "description": "Monthly model spend cap in USD.",
      "minimum": 1,
      "type": "integer"
    },
    "channel": {
      "description": "Release channel; versions are never pinned (ADR-0004).",
      "enum": [
        "stable",
        "testing"
      ],
      "type": "string"
    },
    "connectors": {
      "additionalProperties": {
        "pattern": "^[a-z0-9-]+$",
        "type": "string"
      },
      "description": "Connector kind to vendor. Read-only unless named in workflows.",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "docs",
          "chat",
          "tickets",
          "crm",
          "code",
          "hris",
          "accounting"
        ]
      },
      "type": "object"
    },
    "digest": {
      "description": "The weekly digest's IANA time zone, or off (SB-2103). Default UTC.",
      "type": "string"
    },
    "duties": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "above": {
            "minimum": 0,
            "type": "integer"
          },
          "second": {
            "pattern": "^group:[A-Za-z0-9._-]+$",
            "type": "string"
          }
        },
        "required": [
          "second",
          "above"
        ],
        "type": "object"
      },
      "description": "Segregation of duties per workflow: a second approver group above a threshold (sb-approvals(7)).",
      "propertyNames": {
        "enum": [
          "ticket-update"
        ]
      },
      "type": "object"
    },
    "exclude": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "description": "Source paths or channels never ingested, by connector kind.",
      "propertyNames": {
        "enum": [
          "docs",
          "chat",
          "tickets",
          "crm",
          "code",
          "hris",
          "accounting"
        ]
      },
      "type": "object"
    },
    "groups": {
      "additionalProperties": {
        "items": {
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "description": "Only with an identity-platform idp: group to member emails (SB-907).",
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^group:[A-Za-z0-9._-]+$"
      },
      "type": "object"
    },
    "idp": {
      "description": "Identity provider: oidc://ISSUER-HOST[/path] or identity-platform://PROJECT/IDP_TENANT.",
      "pattern": "^(oidc://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(/[^\\s?#]*)?|identity-platform://[a-z][a-z0-9-]{4,28}[a-z0-9]/[A-Za-z0-9-]{1,63})$",
      "type": "string"
    },
    "language": {
      "description": "The web UI's default language (SB-2301). Default en.",
      "enum": [
        "en",
        "de",
        "fr"
      ],
      "type": "string"
    },
    "notes": {
      "default": false,
      "description": "Stewards may publish replies as notes into the docs: folder share (SB-1705).",
      "type": "boolean"
    },
    "pilot_group": {
      "description": "If set, only this IdP group may sign in.",
      "pattern": "^group:[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "questions_to": {
      "description": "Who answers company-wide questions nothing answered (SB-1704).",
      "pattern": "^group:[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "region": {
      "description": "Region pin. Immutable.",
      "enum": [
        "eu",
        "us"
      ],
      "type": "string"
    },
    "retention_days": {
      "default": 365,
      "description": "Retention for traces, citations and drafts (not audit).",
      "maximum": 3650,
      "minimum": 30,
      "type": "integer"
    },
    "spaces": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "agents": {
            "items": {
              "enum": [
                "ask",
                "draft-reply",
                "incident-summary",
                "spec-digest",
                "close-checklist",
                "runbook-answer",
                "policy-answer",
                "clause-finder",
                "account-brief",
                "case-brief",
                "brand-check",
                "sop-steps",
                "design-rationale",
                "exec-brief"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "channels": {
            "items": {
              "pattern": "^#[a-z0-9][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "fields": {
            "additionalProperties": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "glossary": {
            "additionalProperties": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxProperties": 200,
            "propertyNames": {
              "maxLength": 40,
              "minLength": 1
            },
            "type": "object"
          },
          "label": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "members": {
            "items": {
              "pattern": "^group:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "parent": {
            "pattern": "^[a-z][a-z0-9-]{1,30}$",
            "type": "string"
          },
          "retention_days": {
            "maximum": 3650,
            "minimum": 30,
            "type": "integer"
          },
          "review_after_days": {
            "default": 365,
            "maximum": 3650,
            "minimum": 30,
            "type": "integer"
          },
          "scope": {
            "additionalProperties": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "docs",
                "chat",
                "tickets",
                "crm",
                "code",
                "hris",
                "accounting"
              ]
            },
            "type": "object"
          },
          "start_here": {
            "items": {
              "pattern": "^([a-z]+):(/[^\\s]*/|[^/@\\s][^@\\s]*)$",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array",
            "uniqueItems": true
          },
          "stewards": {
            "items": {
              "pattern": "^group:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "template": {
            "enum": [
              "custom",
              "design",
              "engineering",
              "executive",
              "finance",
              "it-security",
              "legal",
              "marketing",
              "operations",
              "people",
              "product",
              "sales",
              "support"
            ]
          }
        },
        "required": [
          "members",
          "scope"
        ],
        "type": "object"
      },
      "description": "Department spaces (sb-space(5)); they only narrow access.",
      "maxProperties": 50,
      "propertyNames": {
        "not": {
          "const": "company"
        },
        "pattern": "^[a-z][a-z0-9-]{1,30}$"
      },
      "type": "object"
    },
    "tenant": {
      "description": "Tenant name: a DNS label. Immutable.",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
      "type": "string"
    },
    "workflows": {
      "default": [],
      "description": "At most one approval-gated workflow in v1.",
      "items": {
        "enum": [
          "ticket-update"
        ]
      },
      "maxItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "tenant",
    "channel",
    "idp",
    "region",
    "connectors",
    "agents"
  ],
  "title": "Second Brain tenant manifest (sb-tenant(5))",
  "type": "object"
}
